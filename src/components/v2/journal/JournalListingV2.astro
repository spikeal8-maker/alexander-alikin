---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

export interface JournalListEntry {
  title: string;
  description: string;
  href: string;
  kind: string;
  date?: string;
}

export interface Props {
  title: string;
  description: string;
  eyebrow: string;
  entries: JournalListEntry[];
}

const { title, description, eyebrow, entries } = Astro.props;
---

<BaseLayoutV3 title={`${title} — Александр Аликин`} description={description}>
  <div class="v3-page">
    <section class="v3-journal-hero">
      <div class="v3-journal-hero__copy">
        <p class="v3-kicker">{eyebrow}</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      <aside class="v3-journal-hero__aside">
        <p>
          Материалы публикуются после редакционной проверки. Авторские тезисы отделяются от
          подтверждённых фактов и проектных доказательств.
        </p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell">
        {
          entries.length > 0 ? (
            <div class="v3-journal-list">
              {entries.map((entry) => (
                <a href={buildUrl(entry.href)} class="v3-journal-list__item">
                  <div class="v3-journal-list__meta">
                    <span>{entry.kind}</span>
                    {entry.date && <time>{entry.date}</time>}
                  </div>
                  <div>
                    <h2>{entry.title}</h2>
                    <p>{entry.description}</p>
                  </div>
                  <span class="v3-journal-list__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p>В этой рубрике пока нет опубликованных материалов.</p>
          )
        }
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-entry-footer">
        <a class="v3-link" href={buildUrl("/journal/")}>Все рубрики</a>
        <a class="v3-button" href={buildUrl("/rss.xml")}>RSS журнала</a>
      </div>
    </section>
  </div>
</BaseLayoutV3>
