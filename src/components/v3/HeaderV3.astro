---
import { buildUrl } from "@config/site";

const nav = [
  ["Обо мне", "/about/"],
  ["Проекты", "/projects/"],
  ["Бизнесу", "/business/"],
  ["Образованию", "/education/"],
  ["Журнал", "/journal/"],
];
---

<header class="v3-header">
  <div class="v3-header__inner">
    <a class="v3-header__brand" href={buildUrl("/")} aria-label="Александр Аликин — главная">
      <span class="v3-header__name">Александр Аликин</span>
      <span class="v3-header__descriptor">инженер · педагог · предприниматель</span>
    </a>

    <nav class="v3-header__nav" aria-label="Основная навигация">
      {nav.map(([label, href]) => <a href={buildUrl(href)}>{label}</a>)}
    </nav>

    <a class="v3-header__cta" href={buildUrl("/collaboration/")}>Обсудить задачу</a>

    <details class="v3-header__mobile">
      <summary>Меню</summary>
      <nav aria-label="Мобильная навигация">
        {nav.map(([label, href]) => <a href={buildUrl(href)}>{label}</a>)}
        <a href={buildUrl("/collaboration/")}>Обсудить задачу</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .v3-header {
    position: relative;
    z-index: 10;
    background: var(--v3-paper);
    border-bottom: 1px solid var(--v3-line);
  }

  .v3-header__inner {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) auto minmax(12rem, 1fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
    width: min(100%, var(--v3-max));
    min-height: 5.75rem;
    margin: 0 auto;
    padding-inline: var(--v3-gutter);
  }

  .v3-header__brand {
    display: grid;
    gap: 0.2rem;
    width: fit-content;
    text-decoration: none;
  }

  .v3-header__name {
    font-size: 1rem;
    font-weight: 780;
    letter-spacing: -0.025em;
  }

  .v3-header__descriptor {
    color: var(--v3-muted);
    font-family: var(--v3-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .v3-header__nav {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.4rem);
    align-items: center;
  }

  .v3-header__nav a,
  .v3-header__cta {
    font-size: 0.92rem;
    font-weight: 680;
    text-decoration: none;
  }

  .v3-header__nav a {
    position: relative;
    padding-block: 0.4rem;
    color: var(--v3-muted);
  }

  .v3-header__nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 160ms ease;
  }

  .v3-header__nav a:hover,
  .v3-header__nav a:focus-visible {
    color: var(--v3-ink);
  }

  .v3-header__nav a:hover::after,
  .v3-header__nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .v3-header__cta {
    display: inline-flex;
    min-height: 2.9rem;
    padding-inline: 1.15rem;
    align-items: center;
    justify-self: end;
    color: var(--v3-white);
    background: var(--v3-cobalt);
    border: 1px solid var(--v3-cobalt);
  }

  .v3-header__cta:hover,
  .v3-header__cta:focus-visible {
    color: var(--v3-cobalt);
    background: transparent;
  }

  .v3-header__mobile {
    display: none;
  }

  @media (max-width: 1120px) {
    .v3-header__descriptor {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .v3-header__inner {
      grid-template-columns: 1fr auto;
    }

    .v3-header__nav,
    .v3-header__cta {
      display: none;
    }

    .v3-header__mobile {
      position: relative;
      display: block;
    }

    .v3-header__mobile summary {
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 750;
      list-style: none;
    }

    .v3-header__mobile summary::-webkit-details-marker {
      display: none;
    }

    .v3-header__mobile nav {
      position: absolute;
      top: 2.25rem;
      right: 0;
      display: grid;
      min-width: min(19rem, calc(100vw - 2.5rem));
      padding: 1.25rem;
      background: var(--v3-ink);
      box-shadow: var(--v3-shadow);
    }

    .v3-header__mobile nav a {
      padding: 0.85rem 0;
      color: var(--v3-white);
      border-bottom: 1px solid var(--v3-line-light);
      font-size: 1rem;
      text-decoration: none;
    }
  }
</style>
