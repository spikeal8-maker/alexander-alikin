---
import { buildUrl } from "@config/site";
---

<section class="v3-hero">
  <div class="v3-shell v3-hero__grid">
    <div class="v3-hero__copy">
      <div class="v3-hero__identity">
        <p class="v3-kicker">Инженерия · образование · ИИ</p>
        <h1 class="v3-display">
          <span class="v3-display__given">Александр</span>
          <span class="v3-display__family">Аликин</span>
        </h1>
      </div>

      <div class="v3-hero__body">
        <p class="v3-hero__positioning">
          Инженерия, педагогика и предпринимательство — не три роли, а один метод работы.
        </p>
        <p class="v3-hero__summary">
          Разбираю сложную систему, собираю работающую конструкцию, проверяю её на практике и передаю
          людям так, чтобы результат не зависел от одного автора.
        </p>
        <div class="v3-hero__actions">
          <a class="v3-hero__primary" href={buildUrl("/collaboration/")}>Обсудить задачу</a>
          <a class="v3-link" href={buildUrl("/projects/")}>Смотреть проекты</a>
        </div>
      </div>
    </div>

    <figure class="v3-hero__portrait">
      <div class="v3-hero__blue" aria-hidden="true"></div>
      <div class="v3-hero__frame" aria-hidden="true"></div>
      <img
        src={buildUrl("/images/alikin/visualized/hero-main-business.webp")}
        alt="Александр Аликин"
        width="960"
        height="1200"
        loading="eager"
      />
      <figcaption>
        <span>Предприниматель-практик</span>
        <span>Инженер-педагог</span>
      </figcaption>
    </figure>
  </div>

  <div class="v3-shell v3-hero__index">
    <span>01 / Позиция</span>
    <a href="#selected-work">Следом — проекты ↓</a>
    <span>2026</span>
  </div>
</section>

<style>
  .v3-hero {
    overflow: hidden;
    background: var(--v3-paper);
  }

  .v3-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.14fr) minmax(24rem, 0.86fr);
    min-height: clamp(42rem, 82vh, 49rem);
  }

  .v3-hero__copy {
    position: relative;
    z-index: 3;
    align-self: center;
    padding: clamp(4rem, 7vw, 6.75rem) clamp(2rem, 6vw, 6.5rem) 3rem 0;
  }

  .v3-display {
    margin: 0;
  }

  .v3-display__given,
  .v3-display__family {
    display: block;
  }

  .v3-display__given {
    font-family: var(--v3-sans);
    font-size: clamp(4.5rem, 7.2vw, 8.1rem);
    font-weight: 780;
    letter-spacing: -0.078em;
    line-height: 0.84;
  }

  .v3-display__family {
    margin-left: clamp(1.75rem, 4vw, 5rem);
    font-family: var(--v3-serif);
    font-size: clamp(4.7rem, 7.6vw, 8.7rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.072em;
    line-height: 0.88;
  }

  .v3-hero__positioning {
    max-width: 42rem;
    margin: 2.25rem 0 1.35rem;
    font-family: var(--v3-serif);
    font-size: clamp(1.9rem, 2.8vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.04;
  }

  .v3-hero__summary {
    max-width: 38rem;
    margin: 0;
    color: var(--v3-ink-soft);
    font-size: clamp(1.15rem, 1.55vw, 1.32rem);
    line-height: 1.62;
  }

  .v3-hero__actions {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-top: 2.6rem;
  }

  .v3-hero__primary {
    display: inline-flex;
    min-height: 3.6rem;
    padding: 1rem 1.6rem;
    align-items: center;
    color: var(--v3-white);
    background: var(--v3-cobalt);
    border: 1px solid var(--v3-cobalt);
    font-size: 0.98rem;
    font-weight: 760;
    text-decoration: none;
  }

  .v3-hero__primary:hover,
  .v3-hero__primary:focus-visible {
    color: var(--v3-cobalt);
    background: transparent;
  }

  .v3-hero__portrait {
    position: relative;
    min-height: 40rem;
    margin: 0;
    isolation: isolate;
  }

  .v3-hero__portrait img {
    position: absolute;
    inset: 2.25rem -4% 0 4%;
    z-index: 2;
    width: auto;
    height: calc(100% - 2.25rem);
    object-fit: cover;
    object-position: 52% 17%;
    box-shadow: 0 1.5rem 4.5rem rgba(17, 19, 24, 0.16);
  }

  .v3-hero__blue {
    position: absolute;
    inset: 5% -50vw 4% 64%;
    z-index: 0;
    background: var(--v3-cobalt);
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }

  .v3-hero__frame {
    position: absolute;
    top: 1.3rem;
    right: -1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 1;
    border: 1px solid rgba(17, 19, 24, 0.18);
  }

  .v3-hero__portrait figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 1rem;
    z-index: 3;
    display: grid;
    justify-items: end;
    color: var(--v3-white);
    font-family: var(--v3-mono);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .v3-hero__index {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 1rem;
    padding-block: 1.2rem;
    border-top: 1px solid var(--v3-line);
    font-family: var(--v3-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .v3-hero__index a {
    color: var(--v3-cobalt);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .v3-hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .v3-hero__copy {
      padding-right: 0;
      padding-bottom: 3.5rem;
    }

    .v3-display__family {
      margin-left: 0;
    }

    .v3-hero__portrait {
      min-height: 34rem;
      margin-inline: calc(var(--v3-gutter) * -1);
    }

    .v3-hero__portrait img {
      inset: 1.5rem var(--v3-gutter) 0 6%;
      width: calc(94% - var(--v3-gutter));
      height: calc(100% - 1.5rem);
    }

    .v3-hero__blue {
      inset: 4% 0 0 48%;
    }

    .v3-hero__frame {
      top: 0.75rem;
      right: calc(var(--v3-gutter) - 0.75rem);
      bottom: 0.75rem;
      left: calc(6% - 0.75rem);
    }
  }

  @media (max-width: 700px) {
    .v3-hero__grid {
      grid-template-areas:
        "identity"
        "portrait"
        "body";
    }

    .v3-hero__copy {
      display: contents;
    }

    .v3-hero__identity {
      grid-area: identity;
      padding: 2.5rem 0 1.75rem;
    }

    .v3-display {
      display: flex;
      gap: 0.25rem 0.7rem;
      align-items: baseline;
      flex-wrap: wrap;
    }

    .v3-display__given,
    .v3-display__family {
      display: inline;
      margin: 0;
      font-family: var(--v3-sans);
      font-size: clamp(2.8rem, 13vw, 3.7rem);
      font-style: normal;
      font-weight: 780;
      letter-spacing: -0.065em;
      line-height: 0.92;
    }

    .v3-display__family {
      color: var(--v3-cobalt);
    }

    .v3-hero__portrait {
      grid-area: portrait;
      min-height: clamp(19rem, 88vw, 23rem);
      margin-inline: calc(var(--v3-gutter) * -1);
    }

    .v3-hero__portrait img {
      inset: 0 12% 0 0;
      width: 88%;
      height: 100%;
      object-position: 53% 18%;
      box-shadow: none;
    }

    .v3-hero__blue {
      inset: 0 0 0 72%;
      clip-path: none;
    }

    .v3-hero__frame {
      display: none;
    }

    .v3-hero__portrait figcaption {
      right: 0.7rem;
      bottom: 0.7rem;
      left: auto;
      max-width: 24%;
      font-size: 0.5rem;
      line-height: 1.45;
      text-align: right;
    }

    .v3-hero__body {
      grid-area: body;
      padding: 1.65rem 0 2.25rem;
    }

    .v3-hero__positioning {
      max-width: 21rem;
      margin: 0 0 1rem;
      font-size: clamp(1.45rem, 6.5vw, 1.85rem);
      line-height: 1.08;
    }

    .v3-hero__summary {
      max-width: 22rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .v3-hero__actions {
      gap: 0.9rem 1.2rem;
      align-items: center;
      margin-top: 1.5rem;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .v3-hero__primary {
      min-height: 3.15rem;
      padding: 0.8rem 1.05rem;
      font-size: 0.9rem;
    }

    .v3-hero__index {
      display: none;
    }
  }
</style>
