---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";
---

<BaseLayoutV3
  title="Страница не найдена — Александр Аликин"
  description="Запрошенная страница не существует."
>
  <section class="gu-404">
    <div class="gu-404__inner">
      <span class="gu-404__number">Ошибка 404</span>
      <h1>Такой страницы нет.</h1>
      <p>
        Адрес мог измениться, материал мог остаться черновиком или ссылка была введена с ошибкой.
        Приватные и неподтверждённые страницы намеренно не публикуются.
      </p>
      <nav aria-label="Куда перейти">
        <a class="gn-button" href={buildUrl("/")}>На главную</a>
        <a class="gn-text-link" href={buildUrl("/projects/")}>Проекты <span>→</span></a>
        <a class="gn-text-link" href={buildUrl("/search/")}>Поиск <span>→</span></a>
      </nav>
    </div>
  </section>
</BaseLayoutV3>