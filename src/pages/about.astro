---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const roles = [
  ["Инженерная", "Понять устройство, ограничения, данные и архитектуру решения."],
  ["Педагогическая", "Объяснить принцип и сделать результат воспроизводимым для других людей."],
  ["Предпринимательская", "Учитывать спрос, ресурсы, команду, риск и последствия решения."],
];

const arc = [
  [
    "Электроника и робототехника",
    "Работа с устройствами и инженерными проектами сформировала привычку искать причину, проверять конструкцию и объяснять принцип.",
  ],
  [
    "Лига роботов",
    "Образовательная практика превратилась в систему программ, занятий, оборудования и работы с педагогами. Масштабы публикуются только после документальной проверки.",
  ],
  [
    "Laser Love",
    "Сервисный бизнес дал опыт помещения, оборудования, команды, CRM, маркетинга и финансовых ограничений. На сайте не публикуются неподтверждённые показатели выручки.",
  ],
  [
    "ИЗО АСА, ИИ и системы знаний",
    "Текущая работа объединяет образовательный продукт, автоматизацию, персональные системы знаний и редакционный контур с указанием источников.",
  ],
];
---

<BaseLayoutV3
  title="Обо мне — Александр Аликин"
  description="Путь Александра Аликина: электроника, робототехника, образовательные и сервисные бизнесы, ИЗО АСА, ИИ и системы знаний."
>
  <div class="v3-page">
    <section class="v3-page-hero">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Обо мне</p>
        <h1 class="v3-page-hero__title">От инженерной практики к продуктам и системам</h1>
        <p class="v3-page-hero__lead">
          Мой путь проходит через электронику и робототехнику, образовательные программы,
          собственные бизнесы, ИЗО АСА, ИИ и системы знаний. Общая логика — понять устройство,
          собрать решение, проверить его и передать людям.
        </p>
        <p class="v3-page-hero__note">
          Точные даты, масштабы практики и финансовые показатели публикуются только вместе с
          подтверждающим источником.
        </p>
      </div>
      <div class="v3-page-hero__media">
        <img
          src={buildUrl("/images/alikin/visualized/about-portrait-relaxed.webp")}
          alt="Александр Аликин — портрет"
          width="960"
          height="1200"
          loading="eager"
        />
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Три ответственности</p>
          <h2>Не три профессии, а три проверки решения</h2>
          <p>
            Каждая роль отвечает на свой вопрос: работает ли конструкция, понятна ли она людям и
            выдерживает ли реальность.
          </p>
        </div>
        <div class="v3-numbered">
          {
            roles.map(([title, copy], index) => (
              <article class="v3-numbered__item">
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--ink">
      <div class="v3-shell">
        <p class="v3-kicker">Профессиональная дуга</p>
        <div class="v3-process">
          {
            arc.map(([title, copy], index) => (
              <article class="v3-process__item">
                <span>0{index + 1}</span>
                <strong>{title}</strong>
                <p>{copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Факт отдельно. Интерпретация отдельно. Ограничение — рядом с результатом.</blockquote>
        <div>
          <p class="v3-kicker">Редакционная политика</p>
          <p>
            На сайте проекты важнее титулов, visualized-изображения не выдаются за документальные
            события, а приватный архив не становится публичным автоматически.
          </p>
          <a class="v3-link" href={buildUrl("/facts/")}>Факты и источники</a>
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-cta-scene">
        <p class="v3-kicker">Дальше</p>
        <h2>Посмотреть проекты или перейти к контактам</h2>
        <p>В кейсах указаны роль, статус и ограничения. На странице контактов — доступные каналы.</p>
        <div>
          <a class="v3-button" href={buildUrl("/projects/")}>Открыть проекты</a>
          <a class="v3-link" href={buildUrl("/contacts/")}>Контакты</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayoutV3>
