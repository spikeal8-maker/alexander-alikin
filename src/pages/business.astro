---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const signals = [
  [
    "Процесс существует только в головах",
    "Передача между людьми держится на памяти, чатах и ручных напоминаниях.",
  ],
  [
    "Данные не образуют картину",
    "Таблицы, сервисы и отчёты не отвечают на один вопрос: где возникает потеря.",
  ],
  [
    "Рост усиливает хаос",
    "Новая нагрузка требует не ещё одного героического сотрудника, а другой конструкции процесса.",
  ],
];

const stages = [
  ["01", "Разобрать", "Контекст, ограничения, роли, данные и реальная цена проблемы."],
  [
    "02",
    "Нарисовать",
    "Карта процесса: что движется, где возникает задержка и что можно измерить.",
  ],
  [
    "03",
    "Ограничить",
    "Первый этап с понятными границами вместо попытки автоматизировать всё сразу.",
  ],
  ["04", "Проверить", "Рабочий прототип на реальных условиях и наблюдаемый результат."],
  ["05", "Передать", "Документация, объяснение команде и понятные ограничения системы."],
];
---

<BaseLayoutV3
  title="Бизнесу — Александр Аликин"
  description="Разбор процессов, данных и ограничений. Проектирование проверяемого первого этапа без обещаний до диагностики."
>
  <div class="v3-page">
    <section class="v3-page-hero">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Бизнесу</p>
        <h1 class="v3-page-hero__title">Сначала увидеть систему</h1>
        <p class="v3-page-hero__lead">
          Помогаю превратить ручной, разрозненный или перегруженный процесс в понятный рабочий
          контур — с измеримым первым этапом и ясными границами.
        </p>
        <p class="v3-page-hero__note">
          Срок, стоимость и обещание результата появляются только после разбора текущего процесса.
        </p>
      </div>
      <div class="v3-page-hero__media">
        <img
          src={buildUrl("/images/alikin/documentary/06-business-portrait-4x5.webp")}
          alt="Александр Аликин в рабочем пространстве"
          width="1200"
          height="1500"
          loading="eager"
        />
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Когда обращаться</p>
          <h2>Проблема уже стоит дороже разбора</h2>
          <p>
            Задача начинается не с выбора ИИ-инструмента, а с понимания, что именно перестало
            выдерживать реальность.
          </p>
        </div>
        <div class="v3-numbered">
          {
            signals.map(([title, copy], index) => (
              <article class="v3-numbered__item">
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--ink">
      <div class="v3-shell">
        <p class="v3-kicker">Рабочий процесс</p>
        <div class="v3-process">
          {
            stages.map(([number, title, copy]) => (
              <article class="v3-process__item">
                <>
                  <span>{number}</span>
                  <strong>{title}</strong>
                  <p>{copy}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Не внедрение ради внедрения. Сначала — проверяемый участок.</blockquote>
        <div>
          <p class="v3-kicker">Пример текущей практики</p>
          <p>
            В ИЗО АСА архитектура и модульная логика собираются как ограниченная система: без
            публичных обещаний масштаба до работающей версии и проверки модулей.
          </p>
          <a class="v3-link" href={buildUrl("/projects/izo-asa/")}>Открыть кейс</a>
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-cta-scene">
        <p class="v3-kicker">Первый шаг</p>
        <h2>Опишите процесс, который больше нельзя держать вручную</h2>
        <p>
          Достаточно контекста, участников, данных и того, что должно измениться. Решение до
          диагностики не продаю.
        </p>
        <a class="v3-button" href={buildUrl("/collaboration/")}>Обсудить задачу</a>
      </div>
    </section>
  </div>
</BaseLayoutV3>
