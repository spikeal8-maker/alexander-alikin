---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const formats = [
  [
    "Разбор задачи",
    "Контекст, текущее состояние, желаемое изменение и возможность измерить результат.",
  ],
  [
    "Проектирование первого этапа",
    "Границы, данные, роли, риски и проверяемый результат. Срок и стоимость — после разбора.",
  ],
  [
    "Рабочий контур и передача",
    "Ограниченное решение, проверка на реальных условиях, документация и объяснение команде.",
  ],
];

const prepare = [
  "Краткое описание текущей ситуации",
  "Что должно работать иначе",
  "Какие данные и люди участвуют",
  "Что уже пробовали и где возникло ограничение",
];

const mismatch = [
  "Нужно обещание результата до диагностики",
  "Команда не готова участвовать во внедрении",
  "Требуется массовый шаблонный консалтинг",
  "Задача лежит вне инженерии, ИИ, процессов или технического образования",
];
---

<BaseLayoutV3
  title="Обсудить задачу — Александр Аликин"
  description="Предметный разбор бизнес-, технологической или образовательной задачи без неподтверждённых обещаний и шаблонных пакетов."
>
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Сотрудничество</p>
        <h1 class="v3-page-hero__title">Сначала понять задачу</h1>
        <p class="v3-page-hero__lead">
          Первый разговор нужен не для продажи готового пакета. Его задача — понять, что происходит
          сейчас, какое изменение действительно нужно и есть ли проверяемый первый шаг.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <strong>Без обещаний до диагностики</strong>
        <p>Нормальная работа начинается с ограничений, данных и ответственности сторон.</p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Как начинается работа</p>
          <h2>От разговора к рабочему контуру</h2>
          <p>Каждый следующий этап имеет смысл только после результата предыдущего.</p>
        </div>
        <div class="v3-numbered">
          {
            formats.map(([title, copy], index) => (
              <article class="v3-numbered__item">
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--ink">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">До разговора</p>
          <h2>Что подготовить</h2>
        </div>
        <div class="v3-numbered">
          {
            prepare.map((item, index) => (
              <div class="v3-numbered__item">
                <>
                  <span class="v3-numbered__index">0{index + 1}</span>
                  <p>{item}</p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>
          Иногда лучший результат разбора — понять, что мы не подходим друг другу.
        </blockquote>
        <div>
          <p class="v3-kicker">Когда я не подхожу</p>
          <ul>{mismatch.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-cta-scene">
        <p class="v3-kicker">Контекст вместо брифа</p>
        <h2>Опишите ситуацию несколькими абзацами</h2>
        <p>
          Этого достаточно, чтобы определить, есть ли предмет для разговора и какой первый шаг
          разумен.
        </p>
        <a class="v3-button" href={buildUrl("/contacts/")}>Перейти к контактам</a>
      </div>
    </section>
  </div>
</BaseLayoutV3>
