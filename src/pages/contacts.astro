---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const channels = [
  [
    "Публичный GitHub",
    "Исходный код, технические репозитории и развитие цифровой платформы сайта.",
    "https://github.com/spikeal8-maker",
    true,
  ],
  [
    "Проекты и кейсы",
    "ИЗО АСА, инженерное образование, роли, текущие результаты и ограничения.",
    buildUrl("/projects/"),
    false,
  ],
  [
    "Деловой запрос",
    "Подготовить описание бизнес-процесса, образовательной программы или технологического проекта.",
    buildUrl("/collaboration/"),
    false,
  ],
  [
    "СМИ и выступления",
    "Темы комментариев, безопасная биографическая формула и требования к редакционному запросу.",
    buildUrl("/press/"),
    false,
  ],
] as const;

const prepare = [
  "какой процесс, продукт или программа требуют изменения",
  "что сейчас не работает или зависит от ручного усилия",
  "какие данные, люди и системы уже участвуют",
  "какой результат первого этапа можно проверить",
  "какие ограничения нельзя игнорировать",
];
---

<BaseLayoutV3
  title="Контакты — Александр Аликин"
  description="Публичные контакты и прямые переходы к проектам, деловому запросу, GitHub и материалам для СМИ."
>
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Контакты</p>
        <h1 class="v3-page-hero__title">Где связаться и что посмотреть</h1>
        <p class="v3-page-hero__lead">
          Москва / онлайн. Для начала можно открыть проекты, посмотреть техническую работу на GitHub
          или подготовить конкретный запрос по задаче.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <strong>Не публикую вымышленные каналы</strong>
        <p>
          Точный email или Telegram появятся здесь только после фиксации утверждённого адреса.
          Сейчас показаны реально доступные публичные маршруты.
        </p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Прямые переходы</p>
          <h2>Не нужно искать их в футере</h2>
          <p>Каждый пункт ведёт на конкретную страницу или подтверждённый внешний профиль.</p>
        </div>
        <div class="v3-numbered">
          {
            channels.map(([title, copy, href, external], index) => (
              <a
                class="v3-numbered__item"
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
              >
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Хороший первый запрос уже содержит границы задачи.</blockquote>
        <div>
          <p class="v3-kicker">Что подготовить</p>
          <ul>{prepare.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayoutV3>
