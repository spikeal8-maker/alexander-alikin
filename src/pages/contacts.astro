---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const channels = [
  [
    "Предметный запрос",
    "Для обсуждения бизнес-процесса, образовательной программы, проектной разработки или технического участия.",
    buildUrl("/collaboration/"),
    false,
  ],
  [
    "GitHub",
    "Публичная техническая деятельность, исходный код и развитие цифровой платформы сайта.",
    "https://github.com/spikeal8-maker",
    true,
  ],
  [
    "Журнал",
    "Статьи, истории и тезисы об инженерии, образовании, проектах и системном мышлении.",
    buildUrl("/journal/"),
    false,
  ],
] as const;

const prepare = [
  "какой процесс, продукт или программа требуют изменения",
  "что сейчас не работает или зависит от ручного усилия",
  "какие данные, люди и системы уже участвуют",
  "какой результат первого этапа можно проверить",
  "какие ограничения нельзя игнорировать",
];
---

<BaseLayoutV3
  title="Контакты — Александр Аликин"
  description="Проверенные публичные каналы связи и маршруты для предметного обращения."
>
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Контакты</p>
        <h1 class="v3-page-hero__title">Начать с контекста</h1>
        <p class="v3-page-hero__lead">
          Самый быстрый путь к предметному разговору — описать задачу, текущую ситуацию и результат,
          который должен стать наблюдаемым после первого этапа.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <strong>Только проверенные каналы</strong>
        <p>
          Неподтверждённые Telegram, VK и другие профили не публикуются до фиксации официальной
          ссылки.
        </p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Маршруты</p>
          <h2>Выберите правильный контекст</h2>
          <p>
            Не каждый контакт должен начинаться с личного сообщения. Иногда проект или материал уже
            содержит ответ.
          </p>
        </div>
        <div class="v3-numbered">
          {
            channels.map(([title, copy, href, external], index) => (
              <a
                class="v3-numbered__item"
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
              >
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Хороший первый запрос уже содержит границы задачи.</blockquote>
        <div>
          <p class="v3-kicker">Что подготовить</p>
          <ul>{prepare.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayoutV3>
