---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const tasks = [
  [
    "Программы и лаборатории",
    "Проектные форматы по информатике, технологии, робототехнике и применению ИИ.",
    [
      "результат виден в работающем проекте",
      "ошибка становится частью процесса",
      "защита показывает глубину понимания",
    ],
  ],
  [
    "Методическая система",
    "Аудит программы, структура курса, критерии оценки и подготовка педагогов.",
    [
      "понятны роли участника и педагога",
      "зафиксированы требования к площадке",
      "учтены безопасность, авторство и данные",
    ],
  ],
];

const method = [
  ["01", "Действие", "Участник начинает создавать, а не ждёт готового ответа."],
  ["02", "Ошибка", "Ограничение становится видимым и пригодным для разбора."],
  ["03", "Объяснение", "Нужно понять причину, а не подобрать случайный ответ."],
  ["04", "Доработка", "Решение пересобирается осознанно и проверяется снова."],
  ["05", "Защита", "Результат подтверждается через объяснение и демонстрацию."],
];
---

<BaseLayoutV3
  title="Образованию — Александр Аликин"
  description="Инженерные программы, лаборатории и методические системы, в которых результат создаётся, проверяется и объясняется."
>
  <div class="v3-page">
    <section class="v3-page-hero">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Образованию</p>
        <h1 class="v3-page-hero__title">Учиться через действие</h1>
        <p class="v3-page-hero__lead">
          Проектирую программы и лаборатории, где участник создаёт, проверяет, дорабатывает и
          объясняет собственное решение.
        </p>
        <p class="v3-page-hero__note">
          Ценность программы — не в количестве тем, а в том, что человек способен сделать и защитить
          сам.
        </p>
      </div>
      <div class="v3-page-hero__media">
        <img
          src={buildUrl("/images/alikin/visualized/education-presentation.webp")}
          alt="Иллюстрация инженерного образования и проектной работы"
          width="960"
          height="1200"
          loading="eager"
        />
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Два класса задач</p>
          <h2>Создать среду и сделать её воспроизводимой</h2>
          <p>
            Один слой отвечает за опыт участника, второй — за систему, в которой этот опыт можно
            повторить.
          </p>
        </div>
        <div class="v3-numbered">
          {
            tasks.map(([title, copy, items], index) => (
              <article class="v3-numbered__item">
                <span class="v3-numbered__index">0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </>
                  <ul>
                    {items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--ink">
      <div class="v3-shell">
        <p class="v3-kicker">Метод</p>
        <div class="v3-process">
          {
            method.map(([number, title, copy]) => (
              <article class="v3-process__item">
                <>
                  <span>{number}</span>
                  <strong>{title}</strong>
                  <p>{copy}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Результат обучения должен быть виден, объясним и воспроизводим.</blockquote>
        <div>
          <p class="v3-kicker">Доказательность</p>
          <p>
            Публично используется описание авторской методики и действующей практики. Точные
            периоды, масштабы и количественные результаты не публикуются до проверки источников.
          </p>
          <a class="v3-link" href={buildUrl("/projects/engineering-education/")}>Открыть проект</a>
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-cta-scene">
        <p class="v3-kicker">Новая программа</p>
        <h2>Опишите аудиторию, площадку и результат</h2>
        <p>
          Этого достаточно, чтобы понять формат: аудит, лаборатория, программа или подготовка
          педагогов.
        </p>
        <a class="v3-button" href={buildUrl("/collaboration/")}>Обсудить программу</a>
      </div>
    </section>
  </div>
</BaseLayoutV3>
