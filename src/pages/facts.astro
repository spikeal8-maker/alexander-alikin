---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const sourceTypes = [
  ["Авторское утверждение", "Позиция, метод или описание собственной роли. Публикуется с явным пониманием происхождения."],
  ["Публичный источник", "Внешняя страница, публикация, репозиторий или другой доступный материал, который можно проверить."],
  ["Документальная проверка", "Утверждение связано с документом, журналом, выгрузкой или иным первичным доказательством."],
];

const blocked = [
  "точные количества учеников и подготовленных педагогов",
  "поступления, соревнования и достижения третьих лиц",
  "масштаб внедрения и количество пользователей ИЗО АСА",
  "коммерческие сроки и гарантированные результаты",
  "биографические даты без проверенного источника",
];
---

<BaseLayoutV3
  title="Факты и источники — Александр Аликин"
  description="Как сайт отделяет проверяемые факты, авторские утверждения и стратегические рекомендации."
>
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Факты и источники</p>
        <h1 class="v3-page-hero__title">Доверие начинается с происхождения</h1>
        <p class="v3-page-hero__lead">
          Проверяемые факты, слова автора, редакционные связки, стратегические рекомендации и гипотезы учитываются отдельно.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <strong>Число без источника не становится фактом</strong>
        <p>Неподтверждённые сроки, масштабы и достижения остаются во внутреннем реестре, но не выходят в публичный текст.</p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Три уровня</p>
          <h2>Что считается основанием утверждения</h2>
        </div>
        <div class="v3-numbered">
          {sourceTypes.map(([title, copy], index) => (
            <article class="v3-numbered__item">
              <span class="v3-numbered__index">0{index + 1}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v3-editorial-section v3-editorial-section--ink">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Заблокировано</p>
          <h2>Что намеренно не публикуется</h2>
        </div>
        <div class="v3-numbered">
          {blocked.map((item, index) => (
            <div class="v3-numbered__item">
              <span class="v3-numbered__index">0{index + 1}</span><p>{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-statement">
        <blockquote>Приватный документ не становится публичным только потому, что он существует.</blockquote>
        <div>
          <p>Внутренняя редакционная система хранится в репозитории. Персональные данные и закрытый архив проходят отдельную проверку публичности.</p>
          <a class="v3-link" href={buildUrl("/projects/")}>Проверить проекты</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayoutV3>
