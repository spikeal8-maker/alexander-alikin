---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";

const focusItems = [
  ["ИЗО АСА", "Активная разработка архитектуры образовательной платформы для виртуальных лабораторий, групп и учебных проектов."],
  ["Редакционная платформа", "Сайт, журнал и реестр источников приводятся к единой системе, где факт отделён от авторской интерпретации."],
  ["Инженерное образование", "Развиваются проектные форматы, в которых участник создаёт, проверяет и объясняет работающий результат."],
];
---

<BaseLayoutV3 title="Сейчас — Александр Аликин" description="Публично подтверждённые текущие направления работы.">
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Сейчас</p>
        <h1 class="v3-page-hero__title">Текущий рабочий фокус</h1>
        <p class="v3-page-hero__lead">
          Здесь фиксируются только направления, подтверждённые опубликованными проектами и текущим состоянием репозитория.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <strong>Обновлено: июль 2026</strong>
        <p>Точные внешние результаты добавляются только вместе с проверяемым источником.</p>
      </aside>
    </section>

    <section class="v3-editorial-section v3-editorial-section--white">
      <div class="v3-shell v3-section-grid">
        <div class="v3-section-grid__intro">
          <p class="v3-kicker">Три направления</p>
          <h2>Работа, которая идёт сейчас</h2>
          <p>Страница не используется как поток случайных обновлений или обещаний будущих запусков.</p>
        </div>
        <div class="v3-numbered">
          {focusItems.map(([title, copy], index) => (
            <article class="v3-numbered__item">
              <span class="v3-numbered__index">0{index + 1}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v3-editorial-section">
      <div class="v3-shell v3-cta-scene">
        <p class="v3-kicker">Контекст</p>
        <h2>Статусы, роли и ограничения — в проектах</h2>
        <p>Текущий фокус становится понятнее через конкретную архитектуру и границы каждого кейса.</p>
        <a class="v3-button" href={buildUrl("/projects/")}>Открыть проекты</a>
      </div>
    </section>
  </div>
</BaseLayoutV3>
