---
import BaseLayoutV3 from "@layouts/BaseLayoutV3.astro";
import { buildUrl } from "@config/site";
---

<BaseLayoutV3
  title="Поиск — Александр Аликин"
  description="Поиск по проектам, материалам, темам и публичным страницам сайта."
>
  <div class="v3-page">
    <section class="v3-page-hero v3-page-hero--plain">
      <div class="v3-page-hero__copy">
        <p class="v3-kicker">Поиск</p>
        <h1 class="v3-page-hero__title">Найти проект, тему или материал</h1>
        <p class="v3-page-hero__lead">
          Поиск работает по публичному индексу сайта. Приватные заметки, черновики и внутренний
          реестр доказательств в результаты не попадают.
        </p>
      </div>
      <aside class="v3-page-hero__aside">
        <p class="v3-kicker">Граница</p>
        <p>
          Введите название проекта, тему или ключевое понятие. Без JavaScript остаются доступны
          навигация, журнал и основные разделы.
        </p>
      </aside>
    </section>

    <section class="v3-search-panel">
      <div class="v3-shell">
        <label for="search-input" class="v3-search-label">Запрос</label>
        <input
          type="search"
          id="search-input"
          class="v3-search-input"
          placeholder="ИЗО АСА, проектное обучение, автоматизация"
          autocomplete="off"
        />
        <p id="search-status" class="v3-search-status" aria-live="polite">
          Начните вводить запрос.
        </p>
        <ul id="search-results" class="v3-search-results"></ul>
        <noscript>
          <p class="v3-search-status">
            Для интерактивного поиска требуется JavaScript. Перейдите в <a
              href={buildUrl("/projects/")}>проекты</a
            > или <a href={buildUrl("/journal/")}>журнал</a>.
          </p>
        </noscript>
      </div>
    </section>
  </div>
</BaseLayoutV3>

<script>
  interface SearchItem {
    title: string;
    description: string;
    href: string;
  }

  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const results = document.getElementById("search-results") as HTMLUListElement | null;
  const status = document.getElementById("search-status");
  let index: SearchItem[] = [];

  const renderResults = (items: SearchItem[]) => {
    if (!results || !status) return;
    results.replaceChildren();
    status.textContent = items.length ? `Найдено: ${items.length}` : "Совпадений не найдено.";
    for (const item of items) {
      const li = document.createElement("li");
      li.className = "v3-search-result";
      const link = document.createElement("a");
      link.href = item.href;
      link.textContent = item.title;
      const description = document.createElement("p");
      description.textContent = item.description;
      li.append(link, description);
      results.append(li);
    }
  };

  fetch(`${import.meta.env.BASE_URL}search-index.json`)
    .then((response) => response.json())
    .then((data: SearchItem[]) => {
      index = data;
    })
    .catch(() => {
      if (status) status.textContent = "Индекс поиска временно недоступен.";
    });

  input?.addEventListener("input", () => {
    const query = input.value.toLowerCase().trim();
    if (!query) {
      results?.replaceChildren();
      if (status) status.textContent = "Начните вводить запрос.";
      return;
    }
    renderResults(
      index
        .filter(
          (item) =>
            item.title.toLowerCase().includes(query) ||
            item.description.toLowerCase().includes(query),
        )
        .slice(0, 20),
    );
  });
</script>
